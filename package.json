{
  "name": "neo-player-beta",
  "version": "1.0.0",
  "description": "Lecteur Multimédia Platinum Edition",
  "main": "main.js",
  "author": "Théo",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "build": {
    "appId": "com.neoplayer.app",
    "productName": "Neo Player",
    "win": {
      "target": "nsis",
      "icon": "logo.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    },
    "files": [
      "**/*"
    ],
    "directories": {
      "output": "dist"
    }
  },
  "devDependencies": {
    "electron": "^28.0.0",
    "electron-builder": "^26.4.0"
  },
  "dependencies": {
    "fluent-ffmpeg": "^2.1.3",
    "music-metadata": "^7.14.0",
    "systeminformation": "^5.30.3"
  }
}
